# ====================================================================
# POS Basic IA — dependencias de infraestructura (Node.js)
# ====================================================================
# Ejecutar: npm install
# ====================================================================

# --- Dependencias de produccion -----------------------------------
node_modules/
jspm_packages/

# --- Variables de entorno (CRITICO) -------------------------------
# Los secretos NUNCA se versionan.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ...pero la plantilla SI se versiona, para que el equipo sepa que variables existen.
!.env.example

# --- Logs ----------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Coverage / testing -------------------------------------------
coverage/
.nyc_output/
*.lcov

# --- Artefactos de verificacion en navegador ----------------------
# Capturas y dumps que deja la verificacion automatizada con Playwright:
# son evidencia de una corrida, no parte del proyecto.
.playwright-mcp/

# --- Builds / dist ------------------------------------------------
dist/
build/
*.tgz

# --- Dependencias alternative package managers --------------------
.yarn/
.pnp.*
.yarn-integrity

# --- Editores / IDE ----------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~

# --- Sistema operativo --------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Docker ---------------------------------------------------------
# El .env del proyecto ya esta ignorado arriba; se repite por claridad
docker/.env
