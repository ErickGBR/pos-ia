{
  "name": "pos-basic-ia-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend POS Básico IA",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
