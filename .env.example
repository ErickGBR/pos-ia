####################################################################
# POS Basic IA — Variables de entorno (plantilla)
#
# CÓMO USAR:
#   cp .env.example .env
#
# El archivo .env esta en .gitignore y NUNCA debe subirse al repo:
# contiene credenciales reales. Este archivo (.env.example) si se versiona.
#
# REGLA DURA: este archivo solo lleva valores de EJEMPLO. Las claves
# privadas o secretas reales viven unicamente en tu .env local.
####################################################################

# -------------------------------------------------------------------
# SERVIDOR / APP
# -------------------------------------------------------------------
# Entorno de ejecucion: development | production | test
NODE_ENV=development

# Puerto en el que escucha el backend Node/Express.
# BACKEND_PORT es el nombre canonico segun docs/ARQUITECTURA.md.
# PORT se mantiene como alias de compatibilidad.
BACKEND_PORT=3000
PORT=3000

# Origenes permitidos para CORS, separados por coma.
# En desarrollo se usa el puerto del dev server de Vue.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# -------------------------------------------------------------------
# MYSQL 8 (contenedor Docker: servicio `db` de docker-compose.yml)
# -------------------------------------------------------------------
# Host y puerto vistos DESDE el backend Node cuando corre en el host.
# OJO: 3306 en el host ya esta ocupado por un MariaDB del sistema,
# por eso el proyecto usa 3307. El puerto 3306 es el puerto INTERNO
# del contenedor, no lo cambies desde aca.
DB_HOST=127.0.0.1
DB_PORT=3307

# Base de datos que crea el contenedor al primer arranque.
# OJO: MySQL NO permite que el usuario de aplicacion sea 'root'.
DB_NAME=pos_basic_ia
DB_USER=pos_user

# Contrasena del usuario de aplicacion. Valor de ejemplo: cambiala.
DB_PASSWORD=cambiar_password_app

# Contrasena del superusuario root DENTRO del contenedor MySQL.
# Solo se usa para admin local / migraciones manuales.
# docker compose falla a proposito si esta variable no esta definida.
DB_ROOT_PASSWORD=cambiar_password_root

# -------------------------------------------------------------------
# FRONTEND — Vue 2 + Vuetify + Axios
# -------------------------------------------------------------------
# Prefijo de variable de entorno publica para Vue CLI.
# Solo se exponen al bundle las variables con prefijo VUE_APP_*.
# NO poner secretos aca: todo VUE_APP_* viaja al navegador.

# Base URL que usa Axios para las llamadas al backend.
# En desarrollo el backend corre en http://localhost:3000
VUE_APP_API_BASE_URL=http://localhost:3000/api

# Puerto del dev server de Vue (vue-cli-service serve)
VUE_APP_DEV_SERVER_PORT=8080

# Titulo de la aplicacion.
#Va entre comillas porque contiene espacios: sin comillas rompe
# cualquier `source .env` / `set -a; . .env` en shell.
VUE_APP_TITLE="POS Basic IA"

# -------------------------------------------------------------------
# RESERVADO / FUTURO
# -------------------------------------------------------------------
# Secreto de firma para JWT (auth). Sin uso en esta fase, se deja
# declarado para que quede fijo desde el arranque.
# Generar uno real con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_32_bytes_en_hex
